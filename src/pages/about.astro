---
import Page from '../layouts/Page.astro';
import { LINKS, SITE_TITLE } from '../consts';
import Email from '../components/Email.astro';
import { skills, timelineNewestFirst as timeline } from '../data/timeline';
---

<Page
	title={`About | ${SITE_TITLE}`}
	description="Background, experience, education and skills of Maharnab Bhattacharjee."
>
	<section class="panel about">
		<img src="/images/work/headshot.jpg" alt="Portrait of Maharnab Bhattacharjee" width="180" height="187" />
		<div>
			<h1>About</h1>
			<p class="lede">
				I am an experimental physicist at JINR, working on the electromagnetic calorimeter of the MPD experiment
				at NICA.
			</p>
			<p>
				Since joining the project in 2019, I have followed the calorimeter through each stage of construction:
				LED calibration of its 2,400 SiPM readout boards, followed by cosmic-muon testing of the modules and
				half-sectors. I now analyse the cosmic and beam data recorded with the calorimeter installed inside MPD.
			</p>
			<p>
				Most of this work is data analysis, carried out with software I write in C++ and Python: decoding raw
				detector data, fitting large sets of distributions and identifying channels that do not respond
				correctly.
			</p>
			<p>
				Before JINR, I tested mirror actuators for the Thirty Meter Telescope, and during my MS and PhD I designed
				SiPM readout electronics and simulated a calorimeter design with Geant4.
			</p>
			<p>
				My main interests lie in the statistical analysis of large, noisy datasets: fitting and model selection,
				anomaly detection and the use of machine learning on detector data. I am also interested in the computing
				side of this work, from fast data decoding to analysis on GPUs and computing clusters.
			</p>
			<p>
				<em>For collaborations or discussions about these or future projects, please contact me by email or on
				LinkedIn.</em>
			</p>
		</div>
	</section>

	<section class="panel">
		<h2>Experience & education</h2>
		<ol class="timeline">
			{
				timeline.map((t) => (
					<li class={t.kind}>
						<div class="when">{t.period}</div>
						<div>
							<h3>{t.title}</h3>
							<p class="org">{t.org}</p>
							<p>
								{t.text} {t.project && <a href={`/projects/${t.project}/`}>Project →</a>}
							</p>
							{t.refs && (
								<p class="refs">
									See also:{' '}
									{t.refs.map((r, i) => (
										<>
											{i > 0 && ' · '}
											<a href={r.href} target="_blank" rel="noreferrer">{r.label}</a>
										</>
									))}
								</p>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="panel">
		<h2>Skills</h2>
		<div class="grid-2">
			{
				skills.map((s) => (
					<div>
						<h3>{s.group}</h3>
						<ul class="tags">
							{s.items.map((i) => (
								<li>{i}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="panel">
		<h2>Contact</h2>
		<div class="pills">
			<Email />
			<a href={LINKS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
			<a href={LINKS.github} target="_blank" rel="noreferrer">GitHub</a>
			<a href={LINKS.orcid} target="_blank" rel="noreferrer">ORCID</a>
			<a href={LINKS.inspire} target="_blank" rel="noreferrer">INSPIRE-HEP</a>
		</div>
	</section>
</Page>

<style>
	.about {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 1.5rem;
		align-items: start;
	}
	.about img {
		border-radius: 14px;
		width: 180px;
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.timeline li {
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 1rem;
		padding: 0.9rem 0;
		border-bottom: 1px dashed var(--line-soft);
	}
	.timeline li:last-child {
		border-bottom: 0;
	}
	.timeline h3 {
		margin: 0;
	}
	.when {
		font-size: 0.9rem;
		color: var(--text-muted);
		padding-top: 0.15rem;
	}
	.refs {
		margin: 0.2rem 0 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.org {
		margin: 0.1rem 0 0.3rem;
		color: var(--teal);
		font-size: 0.92rem;
	}
	@media (max-width: 640px) {
		.about,
		.timeline li {
			grid-template-columns: 1fr;
		}
		.timeline li {
			gap: 0.2rem;
		}
	}
</style>
