---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AFFILIATION, LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { timeline } from '../data/timeline';

const featured = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const areas = [
	{
		title: 'Statistical data analysis',
		text: 'Fitting and modelling large sets of detector measurements: per-channel response fits, model selection, robust regression and uncertainty estimates across tens of thousands of channels.',
		tools: ['ROOT / RooFit', 'NumPy / SciPy', 'pandas'],
		related: [
			{ slug: 'sipm-board-calibration', label: 'board calibration' },
			{ slug: 'sector-equalisation', label: 'sector equalisation' },
		],
	},
	{
		title: 'Machine learning',
		text: 'Anomaly detection on sensor waveforms with rule-based labels, clustering and PCA for shower reconstruction, and gradient-boosted regression for track seeding.',
		tools: ['scikit-learn', 'XGBoost', 'PyTorch'],
		related: [
			{ slug: 'waveform-anomaly-detection', label: 'waveform anomalies' },
			{ slug: 'dune-nd-ecal-simulation', label: 'shower reconstruction' },
		],
	},
	{
		title: 'Scientific computing',
		text: 'Streaming decoders and analysis pipelines for raw DAQ data in C++17 and Python, batch processing on SLURM clusters, GPU workflows, and databases for detector conditions and monitoring.',
		tools: ['C++17', 'Python', 'CUDA', 'SLURM', 'PostgreSQL'],
		related: [
			{ slug: 'mpd-ecal-data-analysis', label: 'MPD data analysis' },
			{ slug: 'live-monitoring-pipeline', label: 'monitoring design' },
		],
	},
	{
		title: 'Instrumentation and simulation',
		text: 'SiPM readout and test stands, calorimeter calibration with LEDs, cosmic muons and particle beams, and Geant4 simulation of detector response.',
		tools: ['SiPM readout', 'Geant4', 'Qt / embedded C'],
		related: [
			{ slug: 'module-tests-and-beam', label: 'module tests' },
			{ slug: 'dune-nd-ecal-simulation', label: 'Geant4 study' },
			{ slug: 'tmt-actuator-test-software', label: 'TMT test station' },
		],
	},
];
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="panel hero">
		<img class="headshot" src="/images/work/headshot.jpg" alt="Portrait of Maharnab Bhattacharjee" width="230" height="230" />
		<div class="hero-text">
			<p class="eyebrow">{AFFILIATION}</p>
			<h1>Maharnab Bhattacharjee</h1>
			<p class="subtitle">Experimental physicist · detector calibration, data analysis and scientific computing</p>
			<p class="lede">
				I work on the electromagnetic calorimeter of the MPD experiment at NICA, and have followed it through
				every stage of construction: LED calibration of the SiPM readout boards, cosmic-muon QA of the modules
				before they were glued into half-sectors, and cosmic-ray testing of each half-sector before
				installation in MPD. I now analyse the cosmic and beam data recorded with the calorimeter inside the
				detector. Most of my work is analysis software in C++ and Python, with an increasing focus on
				statistical methods and machine learning for detector data.
			</p>
			<div class="pills">
				<a class="btn primary" href="/projects">See projects</a>
				<a class="btn" href="/cv">CV</a>
				<a class="btn" href={`mailto:${LINKS.email}`}>Email</a>
				<a class="btn" href={LINKS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
				<a class="btn" href={LINKS.github} target="_blank" rel="noreferrer">GitHub</a>
			</div>
		</div>
	</section>


	<section class="panel">
		<h2>Selected projects</h2>
		<p class="muted">Case studies: the problem, what I built, the scale and the result.</p>
		<div class="cards">
			{featured.map((p) => <ProjectCard project={p} />)}
		</div>
		<p><a href="/projects">All projects →</a></p>
	</section>

	<section class="panel">
		<h2>Areas of work</h2>
		<div class="grid-2 areas">
			{
				areas.map((a) => (
					<article class="card">
						<h3>{a.title}</h3>
						<p>{a.text}</p>
						<ul class="tags">
							{a.tools.map((t) => (
								<li>{t}</li>
							))}
						</ul>
						<p class="related">
							Related:{' '}
							{a.related.map((r, i) => (
								<>
									{i > 0 && ' · '}
									<a href={`/projects/${r.slug}/`}>{r.label}</a>
								</>
							))}
						</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="panel">
		<h2>Background</h2>
		<ol class="path">
			{
				timeline.map((t) => (
					<li class={t.kind}>
						<span class="dot" aria-hidden="true" />
						<div class="when">{t.period}</div>
						<div class="what">
							<span class="title">{t.title}</span>
							<span class="org">{t.org}</span>
							<p>
								{t.short}
								{t.project && (
									<>
										{' '}
										<a href={`/projects/${t.project}/`}>Details</a>
									</>
								)}
							</p>
						</div>
					</li>
				))
			}
		</ol>
		<p class="legend">
			<span class="k work">work</span>
			<span class="k education">education</span>
			<span class="k internship">internship</span>
			<a href="/about">Full background →</a>
		</p>
	</section>

	{
		posts.length > 0 && (
			<section class="panel">
				<h2>Writing</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<div class="post-date">
								{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
							</div>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Page>

<style>
	.areas .card {
		display: flex;
		flex-direction: column;
	}
	.areas .card p {
		margin: 0.3rem 0 0.4rem;
	}
	.areas .related {
		margin-top: auto !important;
		padding-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.path {
		list-style: none;
		margin: 0.4rem 0 0;
		padding: 0;
		position: relative;
	}
	.path::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 0.6rem;
		bottom: 0.6rem;
		width: 2px;
		background: var(--line-soft);
	}
	.path li {
		position: relative;
		display: grid;
		grid-template-columns: 130px minmax(0, 1fr);
		gap: 1rem;
		padding: 0.55rem 0 0.55rem 1.8rem;
	}
	.path .dot {
		position: absolute;
		left: 0;
		top: 0.95rem;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		border: 3px solid var(--surface);
		background: var(--teal);
		box-shadow: 0 0 0 1px var(--line-strong);
	}
	.path li.education .dot {
		background: var(--accent);
	}
	.path li.internship .dot {
		background: var(--text-muted);
	}
	.path .when {
		font-size: 0.88rem;
		color: var(--text-muted);
		padding-top: 0.2rem;
		white-space: nowrap;
	}
	.path .title {
		font-weight: 600;
		color: var(--text-strong);
		margin-right: 0.5rem;
	}
	.path .org {
		font-size: 0.9rem;
		color: var(--teal);
	}
	.path p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
	.path p a {
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.1rem;
		margin-top: 0.8rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.legend .k::before {
		content: '';
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		margin-right: 0.35rem;
		background: var(--teal);
	}
	.legend .k.education::before {
		background: var(--accent);
	}
	.legend .k.internship::before {
		background: var(--text-muted);
	}
	.legend a {
		margin-left: auto;
	}
	@media (max-width: 640px) {
		.path li {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
	.subtitle {
		margin: 0 0 0.6rem;
		font-size: 1.05rem;
		color: var(--teal);
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 230px;
		gap: 2.2rem;
		align-items: center;
	}
	.hero-text {
		grid-column: 1;
		grid-row: 1;
	}
	.headshot {
		grid-column: 2;
		grid-row: 1;
		width: 230px;
		height: 230px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 30%;
		border: 4px solid var(--surface-2);
		box-shadow: var(--shadow);
	}
	.hero .lede {
		max-width: none;
		text-align: justify;
		hyphens: auto;
	}
	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.headshot {
			grid-column: 1;
			grid-row: 1;
			width: 150px;
			height: 150px;
			margin: 0 auto;
		}
		.hero-text {
			grid-row: 2;
		}
		.hero .lede {
			text-align: left;
		}
	}
</style>
