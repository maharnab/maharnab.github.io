---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AFFILIATION, LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { timeline } from '../data/timeline';

const featured = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="panel hero">
		<img class="headshot" src="/images/work/headshot.jpg" alt="Portrait of Maharnab Bhattacharjee" width="230" height="230" />
		<div class="hero-text">
			<p class="eyebrow">{AFFILIATION}</p>
			<h1>Maharnab Bhattacharjee</h1>
			<p class="subtitle">Experimental physicist · detector calibration, data analysis and scientific computing</p>
			<p class="lede">
				I work on the electromagnetic calorimeter of the MPD experiment at NICA, and have followed it through
				every stage of construction: LED calibration of the SiPM readout boards, cosmic-muon QA of the modules
				before they were glued into half-sectors, and cosmic-ray testing of each half-sector before
				installation in MPD. I now analyse the cosmic and beam data recorded with the calorimeter inside the
				detector. Most of my work is analysis software in C++ and Python, with an increasing focus on
				statistical methods and machine learning for detector data.
			</p>
			<div class="pills">
				<a class="btn primary" href="/projects">See projects</a>
				<a class="btn" href="/cv">CV</a>
				<a class="btn" href={`mailto:${LINKS.email}`}>Email</a>
				<a class="btn" href={LINKS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
				<a class="btn" href={LINKS.github} target="_blank" rel="noreferrer">GitHub</a>
			</div>
		</div>
	</section>


	<section class="panel">
		<h2>Selected projects</h2>
		<p class="muted">Case studies: the problem, what I built, the scale and the result.</p>
		<div class="cards">
			{featured.map((p) => <ProjectCard project={p} />)}
		</div>
		<p><a href="/projects">All projects →</a></p>
	</section>

	<section class="panel">
		<h2>Areas of work</h2>
		<div class="cards">
			<article class="card">
				<h3>Data & ML</h3>
				<p>Statistical modelling and fitting on millions of measurements, anomaly detection on sensor waveforms, feature engineering, scikit-learn / PyTorch / XGBoost.</p>
			</article>
			<article class="card">
				<h3>HPC & performance</h3>
				<p>Streaming C++17 decoders, multi-GB/s data-rate design, SLURM batch processing, CUDA and GPU-accelerated workflows, PostgreSQL bulk ingest.</p>
			</article>
			<article class="card">
				<h3>Detector R&amp;D</h3>
				<p>Geant4 simulation, hardware test stands and the analysis pipelines used in detector production, with an emphasis on documented and reproducible results.</p>
			</article>
		</div>
	</section>

	<section class="panel">
		<h2>Path so far</h2>
		<ul class="flat-list">
			{
				timeline.slice(0, 6).map((t) => (
					<li>
						<span class="muted">{t.period}</span> · <strong>{t.title}</strong> — {t.org}
					</li>
				))
			}
		</ul>
		<p><a href="/about">Full background →</a></p>
	</section>

	{
		posts.length > 0 && (
			<section class="panel">
				<h2>Writing</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<div class="post-date">
								{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
							</div>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Page>

<style>
	.subtitle {
		margin: 0 0 0.6rem;
		font-size: 1.05rem;
		color: var(--teal);
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 230px;
		gap: 2.2rem;
		align-items: center;
	}
	.hero-text {
		grid-column: 1;
		grid-row: 1;
	}
	.headshot {
		grid-column: 2;
		grid-row: 1;
		width: 230px;
		height: 230px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 30%;
		border: 4px solid var(--surface-2);
		box-shadow: var(--shadow);
	}
	.hero .lede {
		max-width: none;
		text-align: justify;
		hyphens: auto;
	}
	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.headshot {
			grid-column: 1;
			grid-row: 1;
			width: 150px;
			height: 150px;
			margin: 0 auto;
		}
		.hero-text {
			grid-row: 2;
		}
		.hero .lede {
			text-align: left;
		}
	}
</style>
