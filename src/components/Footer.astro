---
import { LINKS, SITE_TITLE } from '../consts';
import Email from './Email.astro';
const today = new Date();
---

<footer>
	<p class="links">
		<Email />
	</p>
	<p class="links">
		<a href={LINKS.github} target="_blank" rel="noreferrer">GitHub</a>
		<a href={LINKS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
		<a href={LINKS.orcid} target="_blank" rel="noreferrer">ORCID</a>
		<a href={LINKS.inspire} target="_blank" rel="noreferrer">INSPIRE-HEP</a>
	</p>
	<p class="main">&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		max-width: 1080px;
		margin: 0 auto;
		padding: 2rem 1rem 2.5rem;
		color: var(--text-muted);
		text-align: center;
		font-size: 0.92rem;
	}
	p {
		margin: 0.3rem 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.3rem 1rem;
	}
	a {
		color: var(--accent-strong);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
