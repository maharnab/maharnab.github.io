---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="shell" aria-label="Main">
		<div class="identity">
			<a class="name" href="/">{SITE_TITLE}</a>
			<p>{SITE_TAGLINE}</p>
		</div>
		<div class="links">
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/publications">Publications</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/cv">CV</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 5;
		backdrop-filter: blur(8px);
		background: color-mix(in oklab, var(--surface) 88%, transparent);
		border-bottom: 1px solid var(--line-soft);
	}

	.name {
		font-family: 'Fraunces', Georgia, serif;
		font-weight: 700;
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		color: var(--text-strong);
		text-decoration: none;
	}

	.shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		max-width: 1080px;
		padding: 0.8rem 1rem;
		margin: 0 auto;
	}

	.identity p {
		margin: 0.1rem 0 0;
		font-size: 0.76rem;
		letter-spacing: 0.02em;
		color: var(--text-muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem;
	}

	.links :global(a) {
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		color: var(--text-normal);
		border: 1px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
	}

	.links :global(a:hover),
	.links :global(a.active) {
		border-color: var(--line-strong);
		background: var(--surface-2);
	}

	@media (max-width: 760px) {
		.shell {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
