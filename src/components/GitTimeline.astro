---
// Home-page timeline, newest at the top. Three parallel lines, each running from the row where it
// starts up to the row where it ends (or off the top if ongoing):
//   main  – studies and early positions, ending with the PhD thesis submission
//   advisor, jinr – lanes declared in the data with `lane`
// Short activities inside a degree branch off the main line as a small side dot.
import { timeline, type Entry } from '../data/timeline';

const OPEN = '9999-12';
const endOf = (e: Entry) => e.end ?? OPEN;
const months = (ym: string) => Number(ym.slice(0, 4)) * 12 + Number(ym.slice(5, 7));

const degrees = timeline.filter((e) => e.kind === 'education');
const isStub = (e: Entry) =>
	!e.lane &&
	e.kind !== 'education' &&
	e.kind !== 'milestone' &&
	!!e.end &&
	degrees.some(
		(d) => d.start <= e.start && e.start <= endOf(d) && months(e.end!) <= months(endOf(d)) + 2,
	);

type LaneKey = 'main' | 'advisor' | 'jinr';
const LANES: LaneKey[] = ['main', 'advisor', 'jinr'];
const laneOf = (e: Entry): LaneKey | 'stub' => e.lane ?? (isStub(e) ? 'stub' : 'main');
const rank = { jinr: 3, advisor: 2, stub: 1, main: 0 };

const rows = [...timeline].sort(
	(a, b) => b.start.localeCompare(a.start) || rank[laneOf(b)] - rank[laneOf(a)],
);

// Row span of each line. Lanes other than main with an open-ended entry run off the top (-1).
const span = Object.fromEntries(
	LANES.map((k) => {
		const idx = rows.flatMap((e, i) => (laneOf(e) === k ? [i] : []));
		const open = k !== 'main' && rows.some((e) => laneOf(e) === k && !e.end);
		return [k, { top: open ? -1 : Math.min(...idx), bottom: Math.max(...idx) }];
	}),
) as Record<LaneKey, { top: number; bottom: number }>;

const LANE_W = 24;
const laneX = (k: LaneKey | 'stub') => LANE_W / 2 + LANE_W * (k === 'stub' ? 1 : LANES.indexOf(k));
const W = LANE_W * LANES.length;
const C = 22; // height of a branch curve
const curve = (x1: number) => `M ${laneX('main')} ${C} C ${laneX('main')} ${C * 0.4}, ${x1} ${C * 0.6}, ${x1} 0`;

type Seg = { lane: LaneKey; part: 'full' | 'up' | 'down' };
const segments = (i: number): Seg[] =>
	LANES.flatMap((lane) => {
		const { top, bottom } = span[lane];
		if (i < top || i > bottom || top === bottom) return [];
		if (i === bottom) return [{ lane, part: 'up' as const }];
		if (i === top) return [{ lane, part: 'down' as const }];
		return [{ lane, part: 'full' as const }];
	});

const years = (e: Entry) => {
	const a = e.start.slice(0, 4);
	const b = e.end ? e.end.slice(0, 4) : e.kind === 'milestone' ? a : 'present';
	return a === b ? a : `${a} – ${b}`;
};
const href = (e: Entry) => (e.project ? `/projects/${e.project}/` : undefined);
---

<ol class="tl" style={`--w:${W}px; --c:${C}px`}>
	{
		rows.map((e, i) => {
			const lane = laneOf(e);
			const branches = lane !== 'main' && (lane === 'stub' || i === span[lane].bottom);
			const style = lane === 'stub' ? 'sub' : e.kind === 'milestone' ? 'mile' : 'main';
			return (
				<li class={`row ${style}`}>
					<div class="when">{years(e)}</div>
					<div class="graph" aria-hidden="true">
						{segments(i).map((s) => (
							<span class={`line ${s.part} l-${s.lane} ${i === 0 ? 'top' : ''}`} style={`left:${laneX(s.lane) - 1}px`} />
						))}
						{branches && (
							<svg class={`curve l-${lane}`} width={W} height={C} viewBox={`0 0 ${W} ${C}`}>
								<path d={curve(laneX(lane))} />
							</svg>
						)}
						<span class={`dot d-${style} l-${lane}`} style={`left:${laneX(lane)}px`} />
					</div>
					<div class="what">
						<span class="title">{href(e) ? <a href={href(e)}>{e.title}</a> : e.title}</span>
						<span class="org">{e.org.split(' · ')[0]}</span>
						{style === 'main' && e.earlier && <span class="earlier">{e.earlier}</span>}
						{style === 'main' && e.short && <p>{e.short}</p>}
						{style === 'mile' && <span class="org">· {e.short}</span>}
					</div>
				</li>
			);
		})
	}
</ol>
<p class="more"><slot /></p>

<style>
	.tl {
		--dot-y: 0.95rem;
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
	}
	.row {
		display: grid;
		grid-template-columns: 92px var(--w) minmax(0, 1fr);
		column-gap: 0.9rem;
	}
	.graph {
		position: relative;
	}
	.when {
		text-align: right;
		white-space: nowrap;
		color: var(--text-muted);
		font-size: 0.86rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.45rem;
	}
	.what {
		padding: 0.35rem 0 0.8rem;
	}
	.sub .what,
	.mile .what {
		padding-bottom: 0.45rem;
		font-size: 0.92rem;
	}

	/* lines */
	.line {
		position: absolute;
		width: 2px;
		top: 0;
		bottom: 0;
		background: var(--line-strong);
	}
	.line.up {
		bottom: auto;
		height: var(--dot-y);
	}
	.line.down {
		top: var(--dot-y);
	}
	.line.l-jinr {
		background: var(--teal);
	}
	.curve {
		position: absolute;
		left: 0;
		top: var(--dot-y);
		overflow: visible;
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.curve.l-jinr {
		stroke: var(--teal);
	}

	/* dots */
	.dot {
		position: absolute;
		top: var(--dot-y);
		transform: translate(-50%, -50%);
		border-radius: 50%;
		z-index: 1;
	}
	.d-main {
		width: 16px;
		height: 16px;
		background: var(--surface);
		border: 3px solid var(--line-strong);
		box-sizing: border-box;
	}
	.d-main.l-jinr {
		border-color: var(--teal);
	}
	.d-mile {
		width: 10px;
		height: 10px;
		background: var(--line-strong);
	}
	.d-sub {
		width: 8px;
		height: 8px;
		background: var(--text-muted);
	}

	/* text */
	.title {
		font-weight: 600;
		color: var(--text-strong);
		margin-right: 0.55rem;
	}
	.sub .title,
	.mile .title {
		font-weight: 500;
	}
	.title a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
	}
	.title a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.org {
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.mile .org + .org {
		margin-left: 0.3rem;
	}
	.earlier {
		display: block;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.what p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
	.more {
		margin: 0.4rem 0 0;
		text-align: right;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: var(--w) minmax(0, 1fr);
			column-gap: 0.6rem;
		}
		.when {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding-bottom: 0;
		}
		.graph {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.what {
			grid-column: 2;
			padding-top: 0;
		}
	}
</style>
