---
// Home-page timeline, newest at the top.
//   level 0: the time line itself – one plain line from the first entry to the present.
//   level 1: every main item (degree, position, internship) branches off the time line as a
//            subline running for its duration.
//   level 2: activities that took place within a degree branch off that degree's subline.
// Lines never merge back. Entries that share a `lane` are drawn as one continuous subline.
import { timeline as entries, type Entry } from '../data/timeline';

// Every row is one event at one date. Entries with `endTitle` also get an end event.
const timeline: Entry[] = [
	...entries,
	...entries
		.filter((e) => e.endTitle && e.end)
		.map((e) => ({
			start: e.end!, period: '', title: e.endTitle!, org: '', short: '', text: '',
			kind: 'milestone' as const, lane: e.lane,
		})),
];

const NOW = '9999-12';
const months = (ym: string) => Number(ym.slice(0, 4)) * 12 + Number(ym.slice(5, 7));

type Group = {
	key: string;
	members: Entry[];
	start: string;
	end: string;
	open: boolean;
	level: 1 | 2;
	parent?: Group;
	lane: number;
	startRow: number;
	topRow: number;
};

// Build groups: entries sharing a lane form one subline; every other entry is its own.
const groups = new Map<string, Group>();
for (const e of timeline) {
	const key = e.lane ?? `${e.start}|${e.title}`;
	const g = groups.get(key) ?? {
		key, members: [], start: e.start, end: '', open: false, level: 1, lane: 0, startRow: 0, topRow: 0,
	};
	g.members.push(e);
	groups.set(key, g);
}
for (const g of groups.values()) {
	g.start = g.members.map((e) => e.start).sort()[0];
	g.open = g.members.some((e) => !e.end && e.kind !== 'milestone');
	g.end = g.open
		? NOW
		: g.members.map((e) => (e.kind === 'milestone' ? e.start : e.end!)).sort().at(-1)!;
}
const groupOf = (e: Entry) => groups.get(e.lane ?? `${e.start}|${e.title}`)!;

// Level 2: anything (not itself a degree) that lies within a degree, 2 months' tolerance.
const degreeGroups = [...groups.values()].filter((g) => g.members.some((e) => e.kind === 'education'));
for (const g of groups.values()) {
	if (degreeGroups.includes(g) || g.open) continue;
	const p = degreeGroups.find(
		(d) => d.start <= g.start && g.start <= d.end && months(g.end) <= months(d.end) + 2,
	);
	if (p) {
		g.level = 2;
		g.parent = p;
	}
}

// Rows: one per entry, newest first; on a tie the deeper item goes above (it branches off below).
const rows = [...timeline].sort(
	(a, b) => b.start.localeCompare(a.start) || groupOf(b).level - groupOf(a).level,
);
for (const g of groups.values()) {
	g.startRow = Math.max(...g.members.map((e) => rows.indexOf(e)));
	let k = g.startRow;
	while (k > 0 && rows[k - 1].start <= g.end) k--;
	g.topRow = k;
}

// Lanes (lane 0 is the time line). Newest groups take the innermost free lane, so a new line
// never crosses an older one on its way out. Sub-sublines sit outside their parent.
const all = [...groups.values()];
const byNewest = (a: Group, b: Group) => b.start.localeCompare(a.start);
for (const level of [1, 2] as const) {
	for (const g of all.filter((x) => x.level === level).sort(byNewest)) {
		let lane = (g.parent?.lane ?? 0) + 1;
		while (all.some((o) => o !== g && o.lane === lane && o.start <= g.end && g.start <= o.end)) lane++;
		g.lane = lane;
	}
}
const nLanes = Math.max(...all.map((g) => g.lane));

const LANE_W = 22;
const xOf = (lane: number) => LANE_W / 2 + LANE_W * lane;
const W = LANE_W * (nLanes + 1);
// A branch is a curve followed by a short straight run into the dot. A one-lane branch is an
// S-curve; a longer one is the same S split at its middle, with a straight piece at the S's
// middle slope in between. So every branch has the same angle and the same size of bend.
// Rows that start a branch are tall enough to hold it, so a branch always leaves its parent
// line inside its own row, never at the parent's circle below.
const S = 15;
const SLOPE = 0.6; // rise per unit across at the middle of the one-lane S-curve
const across = (g: Group) => (g.lane - (g.parent ? g.parent.lane : 0)) * LANE_W;
const rise = (g: Group) => LANE_W + SLOPE * (across(g) - LANE_W);
const hOf = (g: Group) => S + rise(g);
const C = S + LANE_W;
const curve = (x0: number, x1: number) => {
	const L = LANE_W;
	const E = x1 - x0 - L; // extra distance covered by the straight piece
	const yb = S + L + SLOPE * E; // bottom, on the parent line
	const xm = x0 + L / 2;
	const ym = yb - L / 2;
	const xn = xm + E;
	const yn = ym - SLOPE * E;
	return (
		`M ${x0} ${yb} C ${x0} ${yb - 0.2 * L}, ${x0 + 0.25 * L} ${yb - 0.35 * L}, ${xm} ${ym} ` +
		`L ${xn} ${yn} C ${xn + 0.25 * L} ${yn - 0.15 * L}, ${x1} ${yn - 0.3 * L}, ${x1} ${S} L ${x1} 0`
	);
};
const last = rows.length - 1;

type Seg = { x: number; part: 'full' | 'up' | 'down' | 'start'; cls: string };
const segments = (i: number): Seg[] => {
	const out: Seg[] = [{ x: xOf(0), part: i === last ? 'start' : 'full', cls: 'time' }];
	for (const g of all) {
		if (i > g.startRow || i < g.topRow || g.topRow === g.startRow) continue;
		const cls = `g-${g.key} lv${g.level}`;
		if (i === g.startRow) out.push({ x: xOf(g.lane), part: 'up', cls });
		else if (i === g.topRow && !g.open && g.members.includes(rows[i])) out.push({ x: xOf(g.lane), part: 'down', cls });
		// a line that ends between events stops level with the last event before its end
		else if (i === g.topRow && !g.open) out.push({ x: xOf(g.lane), part: 'down', cls: `${cls} cap` });
		else out.push({ x: xOf(g.lane), part: 'full', cls });
	}
	return out;
};

// Rows are evenly spaced, so mark the time line wherever a year or more is skipped.
const GAP = 12;
const gapAbove = (i: number) => (i > 0 ? months(rows[i - 1].start) - months(rows[i].start) : 0);
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const when = (e: Entry) => e.startLabel ?? `${MON[Number(e.start.slice(5, 7)) - 1]} ${e.start.slice(0, 4)}`;
const href = (e: Entry) => (e.project ? `/projects/${e.project}/` : undefined);
---

<ol class="tl" style={`--w:${W}px; --c:${C}px`}>
	{
		rows.map((e, i) => {
			const g = groupOf(e);
			const first = g.startRow === i;
			const s = e.kind === 'milestone' ? 'mile' : g.level === 2 ? 'sub' : 'main';
			const from = g.parent ? xOf(g.parent.lane) : xOf(0);
			return (
				<li class={`row ${s}`} style={first ? `min-height: calc(var(--dot-y) + ${hOf(g) + (g.level === 2 ? 4 : 7)}px)` : undefined}>
					<div class="when">{when(e)}</div>
					<div class="graph" aria-hidden="true">
						{segments(i).map((sg) => (
							<span class={`line ${sg.part} ${sg.cls}`} style={`left:${sg.x - 1}px`} />
						))}
						{first && (
							<svg class={`curve g-${g.key} lv${g.level}`} width={W} height={hOf(g)} viewBox={`0 0 ${W} ${hOf(g)}`}>
								<path d={curve(from, xOf(g.lane))} />
							</svg>
						)}
						<span class="leader" style={`left:${xOf(g.lane) + 6}px`} />
						{gapAbove(i) >= GAP && <span class="brk" style={`left:${xOf(0)}px`} />}
						<span class={`dot d-${s} ${first ? 'first' : ''} g-${g.key}`} style={`left:${xOf(g.lane)}px`} />
					</div>
					<div class="what">
						<span class="title">{href(e) ? <a href={href(e)}>{e.title}</a> : e.title}</span>
						{s !== 'mile' && <span class="org">{e.org.split(' · ')[0]}</span>}
						{s === 'main' && e.earlier && <span class="earlier">{e.earlier}</span>}
						{s === 'main' && e.short && <p>{e.short}</p>}
						{s === 'mile' && e.short && <span class="org note">{e.short}</span>}
					</div>
				</li>
			);
		})
	}
</ol>
<p class="more">
	<span class="scale"><span class="brk-key" aria-hidden="true"></span> Events in order. Spacing is not to scale; break marks show where time is compressed.</span>
	<slot />
</p>

<style>
	.tl {
		--dot-y: 0.95rem;
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
	}
	.row {
		display: grid;
		grid-template-columns: 92px var(--w) minmax(0, 1fr);
		column-gap: 0.9rem;
	}
	.graph {
		position: relative;
	}
	.when {
		text-align: right;
		white-space: nowrap;
		color: var(--text-muted);
		font-size: 0.86rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.45rem;
	}
	.what {
		padding: 0.35rem 0 0.8rem;
	}
	.sub .what,
	.mile .what {
		padding-bottom: 0.2rem;
		font-size: 0.92rem;
	}

	/* lines */
	.line {
		position: absolute;
		width: 2px;
		top: 0;
		bottom: 0;
		background: var(--line-strong);
	}
	.line.time {
		background: var(--text-strong);
		opacity: 0.55;
	}
	.line.up {
		bottom: auto;
		height: var(--dot-y);
	}
	.line.down {
		top: var(--dot-y);
	}
	/* the time line starts where the oldest subline branches off */
	.line.start {
		bottom: auto;
		height: calc(var(--dot-y) + var(--c));
	}
	.line.cap::before {
		content: '';
		position: absolute;
		top: -1px;
		left: -3px;
		width: 8px;
		height: 2px;
		background: inherit;
	}
	.line.g-jinr {
		background: var(--teal);
	}
	.curve {
		position: absolute;
		left: 0;
		top: var(--dot-y);
		overflow: visible;
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.curve.lv1 {
		stroke: color-mix(in srgb, var(--text-strong) 55%, transparent);
	}
	.curve.g-jinr {
		stroke: var(--teal);
	}

	/* dots */
	.dot {
		position: absolute;
		top: var(--dot-y);
		transform: translate(-50%, -50%);
		border-radius: 50%;
		z-index: 1;
	}
	.d-main {
		width: 16px;
		height: 16px;
		background: var(--surface);
		border: 3px solid var(--text-strong);
		box-sizing: border-box;
	}
	.d-main:not(.first) {
		width: 12px;
		height: 12px;
		border-width: 2px;
	}
	.d-main.g-jinr {
		border-color: var(--teal);
	}
	.d-mile {
		width: 10px;
		height: 10px;
		background: var(--text-strong);
	}
	.d-sub {
		width: 8px;
		height: 8px;
		background: var(--text-muted);
	}

	/* text */
	.title {
		font-weight: 600;
		color: var(--text-strong);
		margin-right: 0.55rem;
	}
	.sub .title,
	.mile .title {
		font-weight: 500;
	}
	.title a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
	}
	.title a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.org {
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.note {
		margin-left: 0.4rem;
	}
	.note::before {
		content: '· ';
	}
	.earlier {
		display: block;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.what p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
	.more {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem 1.5rem;
		margin: 0.6rem 0 0;
		font-size: 0.9rem;
	}
	.scale {
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	/* dotted leader from each event dot to its text */
	.leader {
		position: absolute;
		top: var(--dot-y);
		right: -0.8rem;
		border-top: 1px dotted var(--line-strong);
		opacity: 0.8;
	}
	.row:hover .leader {
		border-top: 1px solid var(--accent);
		opacity: 1;
	}
	.row:hover .dot {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
	}
	.row:hover .title {
		color: var(--accent);
	}

	/* break mark on the time line: skipped time */
	.brk,
	.brk-key {
		position: absolute;
		top: -5px;
		width: 14px;
		height: 8px;
		transform: translateX(-50%);
		background:
			linear-gradient(160deg, transparent 0 30%, var(--text-muted) 30% 42%, transparent 42% 58%, var(--text-muted) 58% 70%, transparent 70%),
			var(--surface);
		z-index: 2;
	}
	.brk-key {
		position: relative;
		display: inline-block;
		top: 1px;
		transform: none;
		margin-right: 0.3rem;
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: var(--w) minmax(0, 1fr);
			column-gap: 0.6rem;
		}
		.when {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding-bottom: 0;
		}
		.graph {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.what {
			grid-column: 2;
			padding-top: 0;
		}
		/* stop short of the date: the column gap is narrower here */
		.leader {
			right: -0.35rem;
		}
	}
</style>
