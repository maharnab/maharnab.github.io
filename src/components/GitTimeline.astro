---
// Vertical timeline, newest first. Main stages sit on one line; activities that ran in parallel
// with a main stage (fully inside its dates) branch off to the side with a short curve and a dot.
import { kindLabel, timeline, type Entry, type Kind } from '../data/timeline';

const OPEN = '9999-12';
const endOf = (e: Entry) => e.end ?? OPEN;

const rows = [...timeline].sort(
	(a, b) => b.start.localeCompare(a.start) || endOf(b).localeCompare(endOf(a)),
);

// A side branch is a non-degree activity that started during a degree and finished by the
// end of it (2 months' tolerance). Everything else is on the main line.
const months = (ym: string) => Number(ym.slice(0, 4)) * 12 + Number(ym.slice(5, 7));
const degrees = timeline.filter((e) => e.kind === 'education');
const isBranch = (e: Entry) =>
	e.branch ||
	(e.kind !== 'education' &&
	!!e.end &&
	degrees.some(
		(d) => d.start <= e.start && e.start <= endOf(d) && months(e.end!) <= months(endOf(d)) + 2,
		));

const LANE_W = 26;
const DOT_Y = 20; // dot centre from the top of a row
const C = 18; // height of the branch curve
const x0 = LANE_W / 2;
const x1 = LANE_W + LANE_W / 2;
const W = 2 * LANE_W;
const branchPath = `M ${x0} ${C} C ${x0} ${C * 0.45}, ${x1} ${C * 0.55}, ${x1} 0`;
const last = rows.length - 1;
---

<ol class="tl" style={`--w:${W}px; --dot-y:${DOT_Y}px; --c:${C}px`}>
	{
		rows.map((e, j) => {
			const branch = isBranch(e);
			return (
				<li class={branch ? 'branch' : 'main'}>
					<div class="when">{e.period}</div>
					<div class="graph" aria-hidden="true">
						<span class={`spine ${j === 0 ? 'first' : ''} ${j === last ? 'last' : ''}`} style={`left:${x0 - 1}px`} />
						{branch && (
							<svg class="curve" width={W} height={C} viewBox={`0 0 ${W} ${C}`}>
								<path d={branchPath} />
							</svg>
						)}
						<span class={`dot k-${e.kind}`} style={`left:${(branch ? x1 : x0) - 7}px`} />
					</div>
					<div class="what">
						<span class="title">{e.title}</span>
						<span class="org">{e.org}</span>
						<p>
							{e.short}
							{e.project && (
								<>
									{' '}
									<a href={`/projects/${e.project}/`}>Details</a>
								</>
							)}
						</p>
					</div>
				</li>
			);
		})
	}
</ol>
<p class="legend">
	{(['work', 'education', 'project'] as Kind[]).map((k) => <span class={`k k-${k}`}>{kindLabel[k]}</span>)}
	<slot />
</p>

<style>
	.tl {
		list-style: none;
		margin: 0.4rem 0 0;
		padding: 0;
	}
	.tl li {
		display: grid;
		grid-template-columns: 118px var(--w) minmax(0, 1fr);
		column-gap: 0.8rem;
	}
	.when,
	.what {
		padding: 0.5rem 0 0.6rem;
	}
	.when {
		font-size: 0.86rem;
		color: var(--text-muted);
		padding-top: 0.6rem;
		white-space: nowrap;
		text-align: right;
	}
	.graph {
		position: relative;
	}
	.spine {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--line-strong);
	}
	.spine.first {
		top: var(--dot-y);
	}
	.spine.last {
		bottom: auto;
		height: var(--dot-y);
	}
	.curve {
		position: absolute;
		left: 0;
		top: var(--dot-y);
		overflow: visible;
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.dot {
		position: absolute;
		top: calc(var(--dot-y) - 7px);
		width: 14px;
		height: 14px;
		border-radius: 50%;
		border: 3px solid var(--surface);
		box-shadow: 0 0 0 1px var(--line-strong);
		z-index: 1;
	}
	.branch .dot {
		transform: scale(0.85);
	}
	.k-work {
		background: var(--teal);
	}
	.k-education {
		background: var(--accent);
	}
	.k-project {
		background: var(--text-muted);
	}
	.title {
		font-weight: 600;
		color: var(--text-strong);
		margin-right: 0.5rem;
	}
	.branch .title {
		font-weight: 500;
	}
	.org {
		font-size: 0.9rem;
		color: var(--teal);
	}
	.what p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
	.what p a {
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.1rem;
		margin-top: 0.8rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.legend .k {
		background: none;
	}
	.legend .k::before {
		content: '';
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		margin-right: 0.35rem;
		vertical-align: -1px;
	}
	.legend .k-work::before {
		background: var(--teal);
	}
	.legend .k-education::before {
		background: var(--accent);
	}
	.legend .k-project::before {
		background: var(--text-muted);
	}
	.legend :global(a) {
		margin-left: auto;
	}
	@media (max-width: 640px) {
		.tl li {
			grid-template-columns: var(--w) minmax(0, 1fr);
		}
		.when {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding-bottom: 0;
		}
		.graph {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.what {
			grid-column: 2;
			padding-top: 0;
		}
	}
</style>
