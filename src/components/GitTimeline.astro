---
// Home-page timeline, newest at the top. One time line runs from the first entry to the present;
// degrees and other sequential stages sit on it. Every activity that ran in parallel branches off
// at its start and runs alongside for as long as it lasted (several branches when several overlap).
// Branches never merge back. Entries sharing a `lane` are drawn as one continuous branch.
import { timeline, type Entry } from '../data/timeline';

const months = (ym: string) => Number(ym.slice(0, 4)) * 12 + Number(ym.slice(5, 7));
const NOW = '9999-12';
const endOf = (e: Entry) => e.end ?? NOW;

// On the time line: degrees, milestones, and anything that did not run inside a degree.
const degrees = timeline.filter((e) => e.kind === 'education');
const insideDegree = (e: Entry) =>
	!!e.end &&
	degrees.some(
		(d) => d.start <= e.start && e.start <= endOf(d) && months(e.end!) <= months(endOf(d)) + 2,
	);
const onSpine = (e: Entry) =>
	!e.lane && (e.kind === 'education' || e.kind === 'milestone' || !insideDegree(e));

const rows = [...timeline].sort(
	(a, b) => b.start.localeCompare(a.start) || Number(onSpine(a)) - Number(onSpine(b)),
);

// Branches: one per lane, or one per standalone parallel entry.
type Branch = { key: string; start: string; end: string; lane: number; startRow: number; topRow: number };
const keyOf = (e: Entry) => e.lane ?? `${e.start}|${e.title}`;
const branches = new Map<string, Branch>();
rows.forEach((e, i) => {
	if (onSpine(e)) return;
	const k = keyOf(e);
	const b = branches.get(k);
	if (!b) branches.set(k, { key: k, start: e.start, end: endOf(e), lane: 0, startRow: i, topRow: i });
	else {
		b.start = e.start < b.start ? e.start : b.start;
		b.end = endOf(e) > b.end ? endOf(e) : b.end;
		b.startRow = Math.max(b.startRow, i);
	}
});
// A branch runs up through every newer row that started before it ended.
for (const b of branches.values()) {
	let k = b.startRow;
	while (k > 0 && rows[k - 1].start <= b.end) k--;
	b.topRow = k;
}
// Lanes: newest branches take the innermost free lane, so a branch never has to cross an
// older one on its way out from the time line.
const sorted = [...branches.values()].sort((a, b) => b.start.localeCompare(a.start));
const placed: Branch[] = [];
for (const b of sorted) {
	let lane = 1;
	while (placed.some((p) => p.lane === lane && p.start <= b.end && b.start <= p.end)) lane++;
	b.lane = lane;
	placed.push(b);
}
const nLanes = Math.max(1, ...placed.map((b) => b.lane));

const LANE_W = 24;
const xOf = (lane: number) => LANE_W / 2 + LANE_W * lane;
const W = LANE_W * (nLanes + 1);
const C = 22;
const curve = (x1: number) => `M ${xOf(0)} ${C} C ${xOf(0)} ${C * 0.4}, ${x1} ${C * 0.6}, ${x1} 0`;
const last = rows.length - 1;

type Seg = { x: number; part: 'full' | 'up'; cls: string };
const segments = (i: number): Seg[] => {
	const out: Seg[] = [{ x: xOf(0), part: i === last ? 'up' : 'full', cls: 'spine' }];
	for (const b of branches.values()) {
		if (i > b.startRow || i < b.topRow || b.topRow === b.startRow) continue;
		const cls = `b-${b.key === 'jinr' ? 'jinr' : 'other'} ${i === b.topRow && b.end !== NOW ? 'cap' : ''}`;
		out.push({ x: xOf(b.lane), part: i === b.startRow ? 'up' : 'full', cls });
	}
	return out;
};

const years = (e: Entry) => {
	const a = e.start.slice(0, 4);
	const b = e.kind === 'milestone' ? a : e.end ? e.end.slice(0, 4) : 'present';
	return a === b ? a : `${a} – ${b}`;
};
const href = (e: Entry) => (e.project ? `/projects/${e.project}/` : undefined);
const style = (e: Entry) =>
	e.kind === 'milestone' ? 'mile' : onSpine(e) || e.lane ? 'main' : 'sub';
---

<ol class="tl" style={`--w:${W}px; --c:${C}px`}>
	{
		rows.map((e, i) => {
			const b = onSpine(e) ? undefined : branches.get(keyOf(e));
			const x = b ? xOf(b.lane) : xOf(0);
			const s = style(e);
			return (
				<li class={`row ${s}`}>
					<div class="when">{years(e)}</div>
					<div class="graph" aria-hidden="true">
						{segments(i).map((g) => (
							<span class={`line ${g.part} ${g.cls}`} style={`left:${g.x - 1}px`} />
						))}
						{b && b.startRow === i && (
							<svg class={`curve ${b.key === 'jinr' ? 'b-jinr' : ''}`} width={W} height={C} viewBox={`0 0 ${W} ${C}`}>
								<path d={curve(x)} />
							</svg>
						)}
						<span class={`dot d-${s} ${b ? 'on-branch' : 'on-spine'} ${b?.key === 'jinr' ? 'b-jinr' : ''}`} style={`left:${x}px`} />
					</div>
					<div class="what">
						<span class="title">{href(e) ? <a href={href(e)}>{e.title}</a> : e.title}</span>
						<span class="org">{e.org.split(' · ')[0]}</span>
						{s === 'main' && e.earlier && <span class="earlier">{e.earlier}</span>}
						{s === 'main' && e.short && <p>{e.short}</p>}
						{s === 'mile' && e.short && <span class="org note">{e.short}</span>}
					</div>
				</li>
			);
		})
	}
</ol>
<p class="more"><slot /></p>

<style>
	.tl {
		--dot-y: 0.95rem;
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
	}
	.row {
		display: grid;
		grid-template-columns: 92px var(--w) minmax(0, 1fr);
		column-gap: 0.9rem;
	}
	.graph {
		position: relative;
	}
	.when {
		text-align: right;
		white-space: nowrap;
		color: var(--text-muted);
		font-size: 0.86rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.45rem;
	}
	.what {
		padding: 0.35rem 0 0.8rem;
	}
	.sub .what,
	.mile .what {
		padding-bottom: 0.45rem;
		font-size: 0.92rem;
	}

	/* lines */
	.line {
		position: absolute;
		width: 2px;
		top: 0;
		bottom: 0;
		background: var(--line-strong);
	}
	.line.up {
		bottom: auto;
		height: var(--dot-y);
	}
	.line.cap::before {
		content: '';
		position: absolute;
		top: -1px;
		left: -3px;
		width: 8px;
		height: 2px;
		background: inherit;
	}
	.line.b-jinr {
		background: var(--teal);
	}
	.curve {
		position: absolute;
		left: 0;
		top: var(--dot-y);
		overflow: visible;
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.curve.b-jinr {
		stroke: var(--teal);
	}

	/* dots */
	.dot {
		position: absolute;
		top: var(--dot-y);
		transform: translate(-50%, -50%);
		border-radius: 50%;
		z-index: 1;
	}
	.d-main {
		width: 16px;
		height: 16px;
		background: var(--surface);
		border: 3px solid var(--line-strong);
		box-sizing: border-box;
	}
	.d-main.on-spine {
		border-color: var(--text-strong);
	}
	.d-main.b-jinr {
		border-color: var(--teal);
	}
	.d-mile {
		width: 10px;
		height: 10px;
		background: var(--text-strong);
	}
	.d-sub {
		width: 8px;
		height: 8px;
		background: var(--text-muted);
	}

	/* text */
	.title {
		font-weight: 600;
		color: var(--text-strong);
		margin-right: 0.55rem;
	}
	.sub .title,
	.mile .title {
		font-weight: 500;
	}
	.title a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
	}
	.title a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.org {
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.note {
		margin-left: 0.4rem;
	}
	.note::before {
		content: '· ';
	}
	.earlier {
		display: block;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.what p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
	.more {
		margin: 0.4rem 0 0;
		text-align: right;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: var(--w) minmax(0, 1fr);
			column-gap: 0.6rem;
		}
		.when {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding-bottom: 0;
		}
		.graph {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.what {
			grid-column: 2;
			padding-top: 0;
		}
	}
</style>
