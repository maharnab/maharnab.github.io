---
// Home-page timeline, newest first. Main stages sit on one line; activities that ran alongside a
// stage are grouped under it on a short side branch, one compact line each.
import { timeline, type Entry } from '../data/timeline';

const OPEN = '9999-12';
const endOf = (e: Entry) => e.end ?? OPEN;
const months = (ym: string) => Number(ym.slice(0, 4)) * 12 + Number(ym.slice(5, 7));

// A side activity: flagged explicitly, or a non-degree entry that started during a degree and
// finished by its end (2 months' tolerance).
const degrees = timeline.filter((e) => e.kind === 'education');
const isSide = (e: Entry) =>
	e.branch ||
	(e.kind !== 'education' &&
		!!e.end &&
		degrees.some(
			(d) => d.start <= e.start && e.start <= endOf(d) && months(e.end!) <= months(endOf(d)) + 2,
		));

const newestFirst = (a: Entry, b: Entry) =>
	b.start.localeCompare(a.start) || endOf(b).localeCompare(endOf(a));
const main = timeline.filter((e) => !isSide(e)).sort(newestFirst);
const side = timeline.filter(isSide).sort(newestFirst);

// Each side activity hangs under the latest main stage that started on or before it.
const groups = main.map((m) => ({
	m,
	children: side.filter((s) => main.find((p) => p.start <= s.start) === m),
}));

// Years only on the home page; the About page has the months.
const years = (e: Entry) => {
	const a = e.start.slice(0, 4);
	const b = e.end ? e.end.slice(0, 4) : 'present';
	return a === b ? a : `${a} – ${b}`;
};
const href = (e: Entry) => (e.project ? `/projects/${e.project}/` : undefined);
const last = groups.length - 1;
---

<ol class="tl">
	{
		groups.map(({ m, children }, g) => (
			<li class={`group ${g === 0 ? 'first' : ''} ${g === last ? 'last' : ''}`}>
				<div class="row main">
					<div class="when">{years(m)}</div>
					<div class="graph" aria-hidden="true">
						<span class="dot" />
					</div>
					<div class="what">
						<span class="title">{href(m) ? <a href={href(m)}>{m.title}</a> : m.title}</span>
						<span class="org">{m.org.split(' · ')[0]}</span>
						{m.short && <p>{m.short}</p>}
					</div>
				</div>
				{children.map((c, i) => (
					<div class={`row sub ${i === 0 ? 'first' : ''} ${i === children.length - 1 ? 'last' : ''}`}>
						<div class="when">{years(c)}</div>
						<div class="graph" aria-hidden="true">
							{i === 0 && (
								<svg class="curve" width="40" height="18" viewBox="0 0 40 18">
									<path d="M 14 0 C 14 10, 33 6, 33 18" />
								</svg>
							)}
							<span class="stem" />
							<span class="subdot" />
						</div>
						<div class="what">
							<span class="title">{href(c) ? <a href={href(c)}>{c.title}</a> : c.title}</span>
							<span class="org">{c.org.split(' · ')[0]}</span>
						</div>
					</div>
				))}
			</li>
		))
	}
</ol>
<p class="more"><slot /></p>

<style>
	.tl {
		--dot-y: 0.95rem;
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
	}
	.group {
		position: relative;
		padding-bottom: 0.9rem;
	}
	/* the main line runs through the whole group, from the first dot to the last */
	.group::before {
		content: '';
		position: absolute;
		left: calc(92px + 0.9rem + 13px);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--line-strong);
	}
	.group.first::before {
		top: var(--dot-y);
	}
	.group.last::before {
		bottom: auto;
		height: var(--dot-y);
	}
	.row {
		display: grid;
		grid-template-columns: 92px 40px minmax(0, 1fr);
		column-gap: 0.9rem;
	}
	.graph {
		position: relative;
	}
	.when {
		text-align: right;
		white-space: nowrap;
		color: var(--text-muted);
		font-size: 0.86rem;
		font-variant-numeric: tabular-nums;
	}
	.main .when {
		padding-top: 0.45rem;
	}
	.main .what {
		padding: 0.35rem 0 0.35rem;
	}
	.dot {
		position: absolute;
		left: 6px;
		top: calc(var(--dot-y) - 8px);
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--surface);
		border: 3px solid var(--teal);
		box-sizing: border-box;
		z-index: 1;
	}
	.title {
		font-weight: 600;
		color: var(--text-strong);
		margin-right: 0.55rem;
	}
	.title a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
	}
	.title a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.org {
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.main p {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}

	/* side activities */
	.sub {
		--sub-y: 0.85rem;
	}
	.sub .when,
	.sub .what {
		padding: 0.2rem 0;
		font-size: 0.86rem;
	}
	.sub .what {
		font-size: 0.92rem;
	}
	.sub .title {
		font-weight: 500;
	}
	.sub.first .when,
	.sub.first .what {
		padding-top: 0.55rem;
	}
	.curve {
		position: absolute;
		left: 0;
		top: 0;
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-linecap: round;
		overflow: visible;
	}
	.stem {
		position: absolute;
		left: 32px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--line-strong);
	}
	.sub.first .stem {
		top: 18px;
	}
	.sub.last .stem {
		bottom: auto;
		height: calc(var(--sub-y) + 0.25rem);
	}
	.sub.first.last .stem {
		top: 18px;
		height: calc(var(--sub-y) + 0.6rem - 18px);
	}
	.subdot {
		position: absolute;
		left: 29px;
		top: calc(var(--sub-y) + 0.25rem - 4px);
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--text-muted);
	}
	.sub.first .subdot {
		top: calc(var(--sub-y) + 0.6rem - 4px);
	}

	.more {
		margin: 0.4rem 0 0;
		text-align: right;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: 40px minmax(0, 1fr);
			column-gap: 0.6rem;
		}
		.group::before {
			left: 13px;
		}
		.when {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding-bottom: 0 !important;
		}
		.graph {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.what {
			grid-column: 2;
			padding-top: 0 !important;
		}
	}
</style>
